{
  "name": "project-tools",
  "version": "3.8.0",
  "description": "Salesforce Project Management Application - Full-stack web application for managing Salesforce projects, objectives, and teams",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install",
    "restart-backend": "pkill -f 'node server/index.js' || true && npm run server",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=__tests__",
    "test:server": "jest --testPathPattern=server",
    "test:client": "cd client && npm test"
  },
  "keywords": [
    "salesforce",
    "project-management",
    "dashboard",
    "analytics",
    "nodejs",
    "express",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csrf": "^3.1.0",
    "csv-parse": "^5.5.2",
    "csv-parser": "^3.2.0",
    "csv-stringify": "^6.4.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "jsforce": "^1.11.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "multer": "^2.0.2",
    "natural": "^6.10.3",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^5.0.4",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@jest/test-sequencer": "^29.7.0",
    "@types/jest": "^29.5.12",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "nock": "^13.5.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
